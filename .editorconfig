# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt indents with tabs, and go.mod follows it.
[{*.go,go.mod,go.sum}]
indent_style = tab
indent_size = 4

# A recipe line must start with a tab.
[Makefile]
indent_style = tab
indent_size = 4

[{Dockerfile,*.proto,*.py,*.sql}]
indent_size = 4

# Copied from upstream plex-postgresql. Keep them byte-comparable with the
# source, so re-vendoring shows only real changes.
[hack/plex-postgresql/{schema/*.sql,standalone-entrypoint.sh}]
indent_size = 4
trim_trailing_whitespace = false
insert_final_newline = unset
