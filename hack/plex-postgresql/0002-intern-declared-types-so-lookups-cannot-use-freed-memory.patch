 use std::os::raw::{c_char, c_int, c_uint};
 use std::sync::{LazyLock, RwLock};
 
-static DECLTYPE_CACHE: LazyLock<RwLock<HashMap<String, CString>>> =
+/// Declared types, interned so that a pointer handed to a caller stays valid
+/// for the life of the process.
+///
+/// The lookups below return a raw pointer into the stored value and then
+/// release the lock on the way out, so the caller reads the bytes with nothing
+/// held. When the value was an owned CString, re-inserting the same key
+/// dropped the previous one and freed those bytes underneath whichever thread
+/// was mid-read: a use-after-free on the hot path, since every column access
+/// does a lookup.
+///
+/// Leaking is the cheap fix and costs almost nothing: entries are one per
+/// column, and only a value that actually changes leaks anything at all.
+static DECLTYPE_CACHE: LazyLock<RwLock<HashMap<String, &'static CStr>>> =
     LazyLock::new(|| RwLock::new(HashMap::new()));
 static OID_TABLE_CACHE: LazyLock<RwLock<HashMap<u32, CString>>> =
     LazyLock::new(|| RwLock::new(HashMap::new()));
@@ -43,7 +55,16 @@
         Ok(guard) => guard,
         Err(poisoned) => poisoned.into_inner(),
     };
-    cache.insert(key_str.to_string(), normalized_owned);
+    // An unchanged value keeps the pointer readers already hold. A changed one
+    // is interned and the previous allocation is left alone rather than freed,
+    // because a reader may be part way through it.
+    if let Some(existing) = cache.get(key_str) {
+        if existing.to_bytes() == normalized_owned.as_bytes() {
+            return 1;
+        }
+    }
+    let interned: &'static CStr = Box::leak(normalized_owned.into_boxed_c_str());
+    cache.insert(key_str.to_string(), interned);
     1
